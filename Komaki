<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="color-scheme" content="dark">
<title>Komaki X1 Range Pro</title>
<!-- Leaflet CSS for Live Map -->
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
<style>
:root{--bg:#000;--card:#16181b;--line:#2a2e33;--tx:#e8edf2;--mut:#8a94a0;--cy:#18e0ff;--gn:#2fe06b;--rd:#ff5a5a;--am:#ffb02e;--ac:#3aa0ff;box-sizing:border-box}
*{box-sizing:border-box}
body{margin:0;background:radial-gradient(130% 55% at 50% -8%,color-mix(in srgb,var(--ac) 26%,#000),#000 62%) fixed,#000;color:var(--tx);font:15px/1.45 "Segoe UI",Roboto,system-ui,sans-serif;padding:env(safe-area-inset-top,0) 0 env(safe-area-inset-bottom,0)}
header{display:flex;align-items:center;justify-content:space-between;gap:8px;padding:14px 16px;border-bottom:1px solid var(--line)}
h1{font-size:18px;margin:0;letter-spacing:.3px}h1 b{color:var(--ac)}
.st{font-size:12px;color:var(--mut)}.st.on{color:var(--gn)}.st.bad{color:var(--rd)}
nav{position:fixed;left:0;right:0;bottom:0;z-index:9;display:flex;background:rgba(8,9,11,.93);backdrop-filter:blur(12px);border-top:1px solid var(--line);padding-bottom:env(safe-area-inset-bottom,0)}
nav button{flex:1;background:none;border:0;color:var(--mut);padding:10px 4px;font-size:11px;display:flex;flex-direction:column;align-items:center;gap:2px}
nav button span{font-size:20px}nav button.a{color:var(--ac)}
main{padding:12px 12px 88px;max-width:800px;margin:auto}
section{display:none}section.a{display:block}
.card{background:linear-gradient(160deg,#171a1f,#0e1014);border:1px solid color-mix(in srgb,var(--ac) 28%,#23272c);border-radius:16px;padding:16px;margin-bottom:12px}
.k{font-size:12px;color:var(--mut)}.v{font-size:22px;font-weight:600}
button.b,input{font:inherit;color:var(--tx);background:#0d0f11;border:1px solid var(--line);border-radius:10px;padding:10px 14px}
button.b{background:color-mix(in srgb,var(--ac) 16%,#0b0d10);border-color:var(--ac);color:var(--ac);cursor:pointer;font-weight:600}
button.b.g{background:#0f2a18;border-color:var(--gn);color:var(--gn)}
button.b.r{background:#2a1010;border-color:var(--rd);color:var(--rd)}
button:disabled{opacity:.4}
.row{display:flex;gap:8px;flex-wrap:wrap;align-items:center;margin-top:8px}
.hero{display:grid;grid-template-columns:140px 1fr;gap:14px;align-items:center;margin-bottom:12px}
.gauge{position:relative;width:140px;height:140px}
.gauge svg{transform:rotate(-90deg);width:140px;height:140px;filter:drop-shadow(0 0 8px var(--ac))}
.gauge .c{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center}
.gauge .c .v{font-size:32px;color:var(--ac)}
.stats{display:flex;flex-direction:column;gap:6px}
.stat{display:flex;justify-content:space-between;font-size:14px;border-bottom:1px solid #22262b;padding-bottom:4px}
.modes-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin-top:10px;text-align:center}
.mode-box{background:#0d0f11;padding:10px 6px;border-radius:10px;border:1px solid var(--line)}
.trio{display:grid;grid-template-columns:repeat(3,1fr);text-align:center}
.note{font-size:12px;color:var(--mut)}
</style>
</head>
<body>
<header>
  <h1>Komaki X1 <b>Range Pro</b></h1>
  <span id="st" class="st">Disconnected</span>
</header>
<nav id="nav"></nav>
<main>

<!-- HOME / DASHBOARD SECTION -->
<section id="s-dash" class="a">
  <button class="b g" id="hConn" style="width:100%;padding:14px;margin-bottom:12px;font-size:16px">Connect to Scooter</button>
  
  <div class="card">
    <div class="hero">
      <div class="gauge">
        <svg viewBox="0 0 200 200"><circle cx="100" cy="100" r="88" fill="none" stroke="#23272b" stroke-width="14"/><circle id="arc" cx="100" cy="100" r="88" fill="none" stroke="var(--ac)" stroke-width="14" stroke-linecap="round" stroke-dasharray="553" stroke-dashoffset="553"/></svg>
        <div class="c"><div class="v" id="d-soc">--</div><div class="k">Battery</div></div>
      </div>
      <div class="stats">
        <div class="stat"><span class="k">⚡ Voltage</span><b id="d-v">-- V</b></div>
        <div class="stat"><span class="k">〰 Current</span><b id="d-i">-- A</b></div>
        <div class="stat"><span class="k">🌡 Temp</span><b id="d-t">-- °C</b></div>
        <div class="stat"><span class="k">🔌 Status</span><b id="d-chg" style="color:var(--ac)">Idle</b></div>
      </div>
    </div>

    <!-- Charging / Remaining Time Display -->
    <div id="d-time-rem" class="k" style="font-size:13px; color:var(--ac); margin-bottom:10px; text-align:center;">⏱ Time estimation: --</div>

    <div class="k">Estimated Range in All Modes</div>
    <div class="modes-grid">
      <div class="mode-box"><div class="k" style="color:#2fe06b">🍃 Eco</div><div id="rng-eco" class="v" style="font-size:18px">-- km</div></div>
      <div class="mode-box"><div class="k" style="color:#3aa0ff">⏱ Normal</div><div id="rng-normal" class="v" style="font-size:18px">-- km</div></div>
      <div class="mode-box"><div class="k" style="color:#ff3b4a">⚡ Sport</div><div id="rng-sport" class="v" style="font-size:18px">-- km</div></div>
    </div>
  </div>

  <div class="card trio">
    <div><div class="k">Speed</div><div class="v" id="d-spd">0 km/h</div></div>
    <div><div class="k">Distance</div><div class="v" id="d-dist">0.0 km</div></div>
    <div><div class="k">Ride Time</div><div class="v" id="d-time">00:00</div></div>
  </div>

  <div class="card" style="padding:8px">
    <div id="mapH" style="width:100%;height:200px;border-radius:12px;"></div>
  </div>
</section>

<!-- MAP SECTION -->
<section id="s-map">
  <div class="card">
    <b>📍 Live Ride Map</b>
    <div class="note" id="m-pos" style="margin-bottom:8px">GPS tracking starts when connected.</div>
    <div id="mapM" style="width:100%;height:350px;border-radius:12px;"></div>
    <div class="row">
      <button class="b" id="m-find">Recenter Map</button>
      <a class="b" id="m-now" target="_blank" rel="noopener">Open in Google Maps</a>
    </div>
  </div>
</section>

<!-- SETTINGS SECTION -->
<section id="s-settings">
  <div class="card">
    <b>⚙️ Bluetooth & Battery Settings</b>
    <div class="note" style="margin:8px 0">Configure your 15S LiFePO4 pack's 100% full-charge rated ranges.</div>
    <div class="row" style="justify-content:space-between"><label>Eco Max Range (km) <input id="rEco" type="number" style="width:100px"></label></div>
    <div class="row" style="justify-content:space-between"><label>Normal Max Range (km) <input id="rNormal" type="number" style="width:100px"></label></div>
    <div class="row" style="justify-content:space-between"><label>Sport Max Range (km) <input id="rSport" type="number" style="width:100px"></label></div>
    <div class="row" style="margin-top:12px">
      <button class="b g" id="bSaveSettings">Save Settings</button>
      <button class="b r" id="bDis" disabled>Disconnect Scooter</button>
    </div>
  </div>
</section>
</main>

<!-- Leaflet JS -->
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script>
"use strict";
const U = { svc: "0000ff00-0000-1000-8000-00805f9b34fb", rx: "0000ff01-0000-1000-8000-00805f9b34fb", tx: "0000ff02-0000-1000-8000-00805f9b34fb" };
const $ = s => document.querySelector(s);
const LS = {
  get: (k, d) => { try { return JSON.parse(localStorage.getItem(k)) ?? d } catch(e) { return d } },
  set: (k, v) => { try { localStorage.setItem(k, JSON.stringify(v)) } catch(e) {} }
};

let rated = LS.get("rated", { Eco: 120, Normal: 95, Sport: 75 });
$("#rEco").value = rated.Eco;
$("#rNormal").value = rated.Normal;
$("#rSport").value = rated.Sport;

$("#bSaveSettings").onclick = () => {
  rated = { Eco: +$("#rEco").value || 120, Normal: +$("#rNormal").value || 95, Sport: +$("#rSport").value || 75 };
  LS.set("rated", rated);
  alert("Settings saved successfully!");
};

// Navigation
[["dash","Home","🏠"],["map","Map","🗺️"],["settings","Settings","⚙️"]].forEach(([id,n,ic])=>{
  const b=document.createElement("button");
  b.innerHTML=`<span>${ic}</span>${n}`;
  b.onclick = () => {
    document.querySelectorAll("section").forEach(e=>e.classList.toggle("a", e.id === "s-"+id));
    document.querySelectorAll("nav button").forEach(x=>x.classList.toggle("a", x === b));
    setTimeout(()=>{ if(mapH) mapH.invalidateSize(); if(mapM) mapM.invalidateSize(); }, 150);
  };
  $("#nav").appendChild(b);
});
document.querySelector("nav button").classList.add("a");

// Telemetry, Range, and Charging Time Updater
const PACK_CAPACITY_AH = 30; // 30Ah PackDial configured capacity

function updateUI(soc, volt, current, temp, charging) {
  $("#d-soc").textContent = soc != null ? soc + "%" : "--";
  $("#d-v").textContent = volt != null ? volt.toFixed(2) + " V" : "-- V";
  $("#d-i").textContent = current != null ? current.toFixed(1) + " A" : "-- A";
  $("#d-t").textContent = temp != null ? temp + " °C" : "-- °C";
  $("#d-chg").textContent = charging ? "Charging ⚡" : "Discharging";

  // Calculate Ranges
  const factor = (soc != null ? soc : 100) / 100.0;
  $("#rng-eco").textContent = Math.round(rated.Eco * factor) + " km";
  $("#rng-normal").textContent = Math.round(rated.Normal * factor) + " km";
  $("#rng-sport").textContent = Math.round(rated.Sport * factor) + " km";

  // Calculate Charging / Remaining Time
  if (soc != null) {
    const remainingAh = PACK_CAPACITY_AH * (soc / 100);
    let timeStr = "Fully Charged / Idle";
    
    if (charging && current > 0.3) {
      const ahNeeded = PACK_CAPACITY_AH - remainingAh;
      const hoursToFull = ahNeeded / current;
      const h = Math.floor(hoursToFull);
      const m = Math.floor((hoursToFull - h) * 60);
      timeStr = `⚡ Time to full: ${h}h ${m}m (@ ${current.toFixed(1)}A)`;
    } else if (!charging && current < -0.3) {
      const hoursLeft = remainingAh / Math.abs(current);
      const h = Math.floor(hoursLeft);
      const m = Math.floor((hoursLeft - h) * 60);
      timeStr = `⏳ Est. time left: ${h}h ${m}m`;
    }
    $("#d-time-rem").textContent = timeStr;
  }

  const arc = document.getElementById("arc");
  if(arc && soc != null) {
    arc.style.strokeDashoffset = 553 - (553 * soc) / 100;
  }
}

// Maps Initialization
let mapH, markerH, mapM, markerM, routePolyline;
let rideCoords = [];

window.addEventListener('DOMContentLoaded', () => {
  const defaultLatLng = [23.5937, 85.3348];
  
  mapH = L.map('mapH', {zoomControl: false, attributionControl: false}).setView(defaultLatLng, 15);
  L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png').addTo(mapH);
  markerH = L.marker(defaultLatLng).addTo(mapH);

  mapM = L.map('mapM', {attributionControl: false}).setView(defaultLatLng, 15);
  L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png').addTo(mapM);
  markerM = L.marker(defaultLatLng).addTo(mapM);
  routePolyline = L.polyline([], { color: '#3aa0ff', weight: 4 }).addTo(mapM);

  updateUI(100, 54.2, 0.0, 26, false);
});

// GPS Ride Tracker
function startGPS() {
  if (!navigator.geolocation) return;
  navigator.geolocation.watchPosition(pos => {
    const lat = pos.coords.latitude, lng = pos.coords.longitude;
    const speed = (pos.coords.speed || 0) * 3.6;
    const latLng = [lat, lng];

    $("#d-spd").textContent = speed.toFixed(1) + " km/h";
    const url = `https://www.google.com/maps?q=${lat},${lng}`;
    $("#m-now").href = url;

    if(mapH) { markerH.setLatLng(latLng); mapH.panTo(latLng); }
    if(mapM) { markerM.setLatLng(latLng); mapM.panTo(latLng); rideCoords.push(latLng); routePolyline.setLatLngs(rideCoords); }
  }, err => console.warn(err), { enableHighAccuracy: true });
}

$("#h-find")?.onclick = () => { if(mapH && markerH) mapH.panTo(markerH.getLatLng()); };
$("#m-find")?.onclick = () => { if(mapM && markerM) mapM.panTo(markerM.getLatLng()); };

// Bluetooth Connection
let bluetoothDevice = null, rxCharacteristic = null;
async function connectBLE() {
  if (!navigator.bluetooth) { alert("Web Bluetooth is required in Chrome."); return; }
  try {
    document.getElementById("st").textContent = "Connecting...";
    bluetoothDevice = await navigator.bluetooth.requestDevice({
      filters: [{services: [U.svc]}],
      optionalServices: [U.svc]
    });
    
    bluetoothDevice.addEventListener('gattserverdisconnected', () => {
      document.getElementById("st").textContent = "Disconnected";
      document.getElementById("st").className = "st bad";
      $("#bDis").disabled = true;
      $("#hConn").textContent = "Connect to Scooter";
    });

    const server = await bluetoothDevice.gatt.connect();
    const svc = await server.getPrimaryService(U.svc);
    rxCharacteristic = await svc.getCharacteristic(U.rx);
    await rxCharacteristic.startNotifications();

    rxCharacteristic.addEventListener("characteristicvaluechanged", e => {
      const data = new Uint8Array(e.target.value.buffer);
      if(data.length >= 24 && data[0] === 0xDD) {
        const voltage = ((data[4] << 8) | data[5]) * 0.01;
        const rawCurrent = (data[6] << 8) | data[7];
        const current = (rawCurrent > 32768 ? rawCurrent - 65536 : rawCurrent) * 0.01;
        const soc = data[23];
        const temp = (((data[27] << 8) | data[28]) - 2731) * 0.1;
        updateUI(soc, voltage, current, temp, current > 0);
      }
    });

    document.getElementById("st").textContent = "Connected";
    document.getElementById("st").className = "st on";
    $("#bDis").disabled = false;
    $("#hConn").textContent = "Connected ⚡";
    startGPS();
  } catch(e) {
    document.getElementById("st").textContent = "Failed";
    document.getElementById("st").className = "st bad";
    alert("Connection error: " + e.message);
  }
}

$("#hConn").onclick = connectBLE;
$("#bDis").onclick = () => { if(bluetoothDevice?.gatt?.connected) bluetoothDevice.gatt.disconnect(); };
</script>
</body>
</html>
